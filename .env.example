APP_PORT=8000
API_REQUEST_TIMEOUT=5s
API_CACHE_TTL=30s
# Vercel sets PORT automatically. Do not set it manually in Vercel.

# Preferred for hosted PostgreSQL. Leave empty locally to use the DB_* values.
DATABASE_URL=
DB_PORT=5432
DB_HOST=localhost
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=mydatabase
# Connections per running instance. On serverless hosts keep this small:
# instances x DB_MAX_CONNS must stay under the database role's connection limit.
DB_MAX_CONNS=3
DB_MIN_CONNS=0

DB_TEST_PORT=5433
DB_TEST_HOST=localhost
DB_TEST_USER=myuser
DB_TEST_PASSWORD=mypassword
DB_TEST_NAME=testdatabase

JWT_SECRET=myjwtsecret
JWT_EXPIRATION=3600
JWT_ISSUER=brothers-app
JWT_AUDIENCE=brothers-api

# Formula-style API error reporting. An empty token disables delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1003866068293
# Optional: Error backend Forum Topic's message_thread_id for API error reports.
# Leave empty to send to General.
TELEGRAM_BACKEND_ERROR_THREAD_ID=

# SMTP relay used to deliver email OTPs. This follows Formula's SMTP format.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
OTP_PEPPER=change-this-in-production
OTP_EXPIRATION=120
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=5

APP_ENV=development
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
# Sessions, OTP, and API response cache. Use a hosted Redis URL in production.
REDIS_URL=redis://localhost:6379/0

APP_PORT=8000
# Vercel sets PORT automatically. Do not set it manually in Vercel.

# Preferred for hosted PostgreSQL. Leave empty locally to use the DB_* values.
DATABASE_URL=
DB_PORT=5432
DB_HOST=localhost
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=mydatabase

DB_TEST_PORT=5433
DB_TEST_HOST=localhost
DB_TEST_USER=myuser
DB_TEST_PASSWORD=mypassword
DB_TEST_NAME=testdatabase

JWT_SECRET=myjwtsecret
JWT_EXPIRATION=3600
JWT_ISSUER=brothers-app
JWT_AUDIENCE=brothers-api

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_API_URL=https://api.telegram.org
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_HTTP_TIMEOUT=10
# Required by the Telegram webhook endpoint in production.
TELEGRAM_WEBHOOK_SECRET=
OTP_PEPPER=change-this-in-production
# Development only. Leave empty in production to generate random OTP values.
OTP_DEFAULT_CODE=111111
OTP_EXPIRATION=300
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=5

APP_ENV=development
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
# Use a hosted Redis URL in production (for example, rediss://...).
REDIS_URL=redis://localhost:6379/0
